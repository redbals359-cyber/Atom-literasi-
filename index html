<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ATOM Literasi</title>

<style>
:root{
  --primary:#5b5ce2;
  --primary-dark:#4546c8;
  --secondary:#eef0ff;
  --bg:#f6f7fb;
  --card:#fff;
  --text:#182033;
  --muted:#70798d;
  --border:#e5e8f0;
  --green:#19a974;
  --shadow:0 10px 30px rgba(35,40,80,.08);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Inter,Segoe UI,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,input,textarea{
  font-family:inherit;
}

button{
  cursor:pointer;
  border:none;
}

.app{
  display:flex;
  min-height:100vh;
}

/* SIDEBAR */

.sidebar{
  width:245px;
  background:#151a2d;
  color:white;
  position:fixed;
  inset:0 auto 0 0;
  padding:22px 15px;
  z-index:20;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:800;
  font-size:20px;
  padding:10px;
  margin-bottom:25px;
}

.logo-icon{
  width:40px;
  height:40px;
  background:linear-gradient(135deg,#6366f1,#8b5cf6);
  border-radius:13px;
  display:grid;
  place-items:center;
  font-size:22px;
}

.nav-title{
  color:#737b91;
  font-size:11px;
  font-weight:700;
  letter-spacing:1px;
  padding:10px;
  text-transform:uppercase;
}

.nav button{
  width:100%;
  padding:12px;
  margin:4px 0;
  background:transparent;
  color:#c7ccda;
  border-radius:12px;
  text-align:left;
  display:flex;
  align-items:center;
  gap:11px;
}

.nav button:hover,
.nav button.active{
  background:#292f48;
  color:white;
}

/* MAIN */

.main{
  margin-left:245px;
  width:calc(100% - 245px);
  padding:28px;
}

.page{
  display:none;
}

.page.active{
  display:block;
}

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:22px;
}

.topbar h1{
  font-size:28px;
}

.topbar p{
  color:var(--muted);
  margin-top:5px;
}

.teacher-avatar{
  width:48px;
  height:48px;
  border-radius:50%;
  background:#fff4ce;
  display:grid;
  place-items:center;
  font-size:25px;
}

/* CARD */

.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:20px;
  padding:22px;
  box-shadow:var(--shadow);
}

.grid{
  display:grid;
  grid-template-columns:repeat(12,1fr);
  gap:18px;
}

.hero{
  grid-column:span 8;
  min-height:260px;
  background:linear-gradient(135deg,#eef0ff,#faf5ff);
  position:relative;
  overflow:hidden;
}

.hero h2{
  font-size:31px;
  max-width:680px;
  margin:10px 0;
}

.hero p{
  max-width:650px;
  color:#59647a;
  line-height:1.7;
}

.teacher{
  position:absolute;
  right:35px;
  bottom:5px;
  font-size:105px;
  opacity:.9;
}

.badge{
  display:inline-block;
  background:var(--secondary);
  color:var(--primary);
  padding:6px 10px;
  border-radius:999px;
  font-size:11px;
  font-weight:800;
}

.btn{
  background:var(--primary);
  color:white;
  padding:11px 16px;
  border-radius:12px;
  font-weight:700;
  margin-top:15px;
}

.btn:hover{
  background:var(--primary-dark);
}

.btn-light{
  background:var(--secondary);
  color:var(--primary);
}

/* STATS */

.stats{
  grid-column:span 4;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.stat{
  background:white;
  border:1px solid var(--border);
  border-radius:17px;
  padding:16px;
}

.stat-label{
  font-size:12px;
  color:var(--muted);
}

.stat-number{
  display:block;
  font-size:27px;
  font-weight:850;
  margin:5px 0;
}

/* SECTION */

.section{
  grid-column:1/-1;
}

.section-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:12px;
}

/* MISSION */

.missions{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.mission{
  background:white;
  border:1px solid var(--border);
  border-radius:17px;
  padding:18px;
}

.mission h3{
  margin:10px 0 7px;
}

.mission p{
  color:var(--muted);
  font-size:14px;
  line-height:1.5;
}

/* PROGRESS */

.progress{
  width:100%;
  height:10px;
  background:#e8eaf0;
  border-radius:999px;
  overflow:hidden;
}

.progress-bar{
  height:100%;
  width:0%;
  background:linear-gradient(90deg,var(--primary),#8b5cf6);
  border-radius:999px;
  transition:.4s;
}

/* ATOM */

.atom-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-top:18px;
}

.atom-card{
  padding:20px;
  background:white;
  border:1px solid var(--border);
  border-radius:18px;
}

.atom-letter{
  font-size:35px;
  color:var(--primary);
  font-weight:900;
}

.atom-card h3{
  margin:3px 0 8px;
}

.atom-card p{
  color:var(--muted);
  line-height:1.55;
  font-size:14px;
}

.micro{
  margin-top:12px;
  background:#f5f6ff;
  padding:9px;
  border-radius:10px;
  font-size:12px;
  color:var(--primary);
  font-weight:700;
}

/* DAILY TEXT */

.daily-text{
  max-width:900px;
}

.daily-text h2{
  margin:12px 0;
}

.daily-text p{
  color:#505b70;
  line-height:1.8;
  margin-bottom:15px;
}

.structure{
  display:inline-block;
  padding:6px 9px;
  border-radius:8px;
  background:#f1f2f6;
  font-size:11px;
  font-weight:800;
}

/* SEARCH */

.search-box{
  position:relative;
  margin:20px 0;
}

.search-box input{
  width:100%;
  padding:16px 18px 16px 48px;
  border:1px solid var(--border);
  border-radius:15px;
  outline:none;
  font-size:15px;
  background:white;
}

.search-box input:focus{
  border-color:var(--primary);
  box-shadow:0 0 0 3px rgba(91,92,226,.1);
}

.search-icon{
  position:absolute;
  left:18px;
  top:15px;
}

/* COMPONENT RESULT */

.component-result{
  background:white;
  border:1px solid var(--border);
  border-radius:18px;
  padding:20px;
  margin-top:12px;
  display:none;
}

.component-result.show{
  display:block;
}

.component-result h3{
  color:var(--primary);
  margin-bottom:8px;
}

.component-result p{
  color:var(--muted);
  line-height:1.7;
}

.component-example{
  background:#f5f6ff;
  padding:13px;
  border-radius:12px;
  margin-top:12px;
  font-size:13px;
}

/* REFLECTION */

.reflection{
  max-width:800px;
}

.question{
  margin-bottom:18px;
}

.question label{
  display:block;
  font-weight:700;
  margin-bottom:8px;
}

textarea{
  width:100%;
  min-height:100px;
  border:1px solid var(--border);
  border-radius:13px;
  padding:12px;
  resize:vertical;
  outline:none;
}

/* MODAL */

.modal{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(10,15,30,.6);
  z-index:100;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.modal.show{
  display:flex;
}

.modal-content{
  width:min(850px,100%);
  max-height:90vh;
  overflow:auto;
  background:white;
  border-radius:23px;
  padding:27px;
}

.close{
  float:right;
  padding:8px 11px;
  border-radius:9px;
  background:#f1f3f7;
}

/* TOAST */

.toast{
  position:fixed;
  right:25px;
  bottom:25px;
  background:#151a2d;
  color:white;
  padding:14px 18px;
  border-radius:13px;
  display:none;
  z-index:200;
}

/* MOBILE */

@media(max-width:950px){

.sidebar{
  width:75px;
}

.logo span,
.nav-title,
.nav button span{
  display:none;
}

.main{
  margin-left:75px;
  width:calc(100% - 75px);
}

.hero,
.stats{
  grid-column:1/-1;
}

.atom-grid{
  grid-template-columns:1fr 1fr;
}

}

@media(max-width:650px){

.main{
  padding:16px;
}

.missions,
.atom-grid{
  grid-template-columns:1fr;
}

.hero h2{
  font-size:25px;
}

.teacher{
  opacity:.15;
}

.stats{
  grid-template-columns:1fr 1fr;
}

}
</style>
</head>


<body>

<div class="app">

<!-- SIDEBAR -->

<aside class="sidebar">

<div class="logo">
  <div class="logo-icon">⚛</div>
  <span>ATOM Literasi</span>
</div>

<div class="nav">

<div class="nav-title">Pembelajaran</div>

<button class="active" onclick="showPage('dashboard',this)">
🏠 <span>Dashboard</span>
</button>

<button onclick="showPage('daily',this)">
📖 <span>Teks Hari Ini</span>
</button>

<button onclick="showPage('atom',this)">
⚛️ <span>Progress ATOM</span>
</button>

<button onclick="showPage('literasi',this)">
🔎 <span>Komponen Literasi</span>
</button>

<button onclick="showPage('refleksi',this)">
🪞 <span>Refleksi Harian</span>
</button>

</div>

</aside>


<main class="main">


<!-- ================= DASHBOARD ================= -->

<section id="dashboard" class="page active">

<div class="topbar">

<div>
<h1>Halo, Literator! 👋</h1>
<p>Satu tindakan kecil setiap hari.</p>
</div>

<div class="teacher-avatar">
👨‍🏫
</div>

</div>


<div class="grid">

<div class="card hero">

<span class="badge">ATOM LITERASI</span>

<h2>
Kecil dalam tindakan,
besar dalam kebiasaan.
</h2>

<p>
ATOM Literasi mengubah proses literasi menjadi
tindakan kecil yang bisa dilakukan setiap hari.
</p>

<button class="btn" onclick="showPage('daily')">
Mulai Literasi Hari Ini →
</button>

<div class="teacher">🧑‍🏫</div>

</div>


<div class="stats">

<div class="stat">
<span class="stat-label">🔥 Streak</span>
<span class="stat-number" id="streak">0</span>
<span class="stat-label">hari</span>
</div>

<div class="stat">
<span class="stat-label">⚛️ ATOM</span>
<span class="stat-number" id="atomCount">0</span>
<span class="stat-label">terkumpul</span>
</div>

<div class="stat">
<span class="stat-label">⭐ XP</span>
<span class="stat-number" id="xp">0</span>
<span class="stat-label">pengalaman</span>
</div>

<div class="stat">
<span class="stat-label">🏅 Level</span>
<span class="stat-number" id="level">1</span>
<span class="stat-label">Literator</span>
</div>

</div>


<div class="section">

<div class="section-header">
<h2>Teks Hari Ini 📖</h2>
</div>

<div class="card">

<span class="badge" id="todayType">
Teks
</span>

<h2 id="todayTitle" style="margin:12px 0">
-
</h2>

<p id="todaySkill"
style="color:var(--muted)">
-
</p>

<button class="btn" onclick="showPage('daily')">
Baca Teks →
</button>

</div>

</div>


<div class="section">

<div class="section-header">

<h2>Progress ATOM</h2>

<span id="progressText">
0 / 30
</span>

</div>

<div class="card">

<div class="progress">

<div
class="progress-bar"
id="progressBar">
</div>

</div>

<p style="margin-top:12px;color:var(--muted)">
Setiap hari cukup satu teks dan satu proses literasi.
</p>

</div>

</div>

</div>

</section>



<!-- ================= TEKS HARI INI ================= -->

<section id="daily" class="page">

<div class="topbar">

<div>

<h1>Teks Hari Ini 📖</h1>

<p id="dayLabel">
Literasi harian
</p>

</div>

</div>


<div class="card daily-text">

<span class="badge" id="dailyType">
-
</span>

<h2 id="dailyTitle">
-
</h2>

<p>
<strong id="dailySkill">
-
</strong>
</p>

<span class="structure" id="dailyStructure">
-
</span>

<hr style="margin:25px 0;border:0;border-top:1px solid #eee">

<div id="dailyContent">
</div>


<div class="card"
style="margin-top:25px;background:#f8f8ff">

<h3>⚛️ Tantangan ATOM</h3>

<p style="margin-top:8px">

<strong>A — Akses:</strong>
Temukan informasi utama dari teks.

<br><br>

<strong>T — Telaah:</strong>
Tanyakan apakah alasan atau informasi dalam teks masuk akal.

<br><br>

<strong>O — Olah:</strong>
Hubungkan isi teks dengan kehidupan nyata.

<br><br>

<strong>M — Manfaatkan:</strong>
Tentukan satu tindakan kecil berdasarkan pemahamanmu.

</p>

<button
class="btn"
onclick="completeToday()"
id="completeButton"
>
Selesaikan Hari Ini +1 ATOM
</button>

</div>

</div>

</section>



<!-- ================= ATOM ================= -->

<section id="atom" class="page">

<div class="topbar">

<div>

<h1>⚛️ Progress ATOM</h1>

<p>
Empat tindakan kecil yang membentuk kebiasaan literasi.
</p>

</div>

</div>


<div class="card">

<h2>Apa itu ATOM?</h2>

<p style="color:var(--muted);line-height:1.8;margin-top:10px">

ATOM adalah gambaran bahwa literasi tidak harus
dimulai dari aktivitas besar.

Satu tindakan kecil yang dilakukan berulang
dapat menjadi kebiasaan.

</p>


<div class="atom-grid">


<div class="atom-card">

<div class="atom-letter">A</div>

<h3>Akses</h3>

<p>
Mencari dan menemukan informasi yang relevan.
</p>

<div class="micro">
Cari 1 informasi valid.
</div>

</div>


<div class="atom-card">

<div class="atom-letter">T</div>

<h3>Telaah</h3>

<p>
Memahami, mempertanyakan, dan memeriksa informasi.
</p>

<div class="micro">
Tanyakan: “Mengapa?”
</div>

</div>


<div class="atom-card">

<div class="atom-letter">O</div>

<h3>Olah</h3>

<p>
Menghubungkan, membandingkan, dan menyimpulkan.
</p>

<div class="micro">
Buat 1 hubungan.
</div>

</div>


<div class="atom-card">

<div class="atom-letter">M</div>

<h3>Manfaatkan</h3>

<p>
Menggunakan informasi untuk keputusan atau tindakan.
</p>

<div class="micro">
Lakukan 1 aksi kecil.
</div>

</div>

</div>

</div>

</section>



<!-- ================= KOMPONEN LITERASI ================= -->

<section id="literasi" class="page">

<div class="topbar">

<div>

<h1>🔎 Komponen Literasi</h1>

<p>
Cari komponen literasi yang ingin kamu pahami.
</p>

</div>

</div>


<div class="card">

<h2>LITERASI</h2>

<p style="color:var(--muted);margin-top:8px">
Delapan proses untuk mengubah informasi menjadi pemahaman dan tindakan.
</p>


<div class="search-box">

<span class="search-icon">🔎</span>

<input
type="text"
id="searchComponent"
placeholder="Cari komponen... contoh: Telaah, Evaluasi, Akses"
oninput="searchLiteracy()"
>

</div>


<div id="componentResults"></div>


</div>

</section>



<!-- ================= REFLEKSI ================= -->

<section id="refleksi" class="page">

<div class="topbar">

<div>

<h1>🪞 Refleksi Harian</h1>

<p>
Berhenti sejenak untuk melihat apa yang berubah.
</p>

</div>

</div>


<div class="card reflection">

<div class="question">

<label>
1. Apa hal baru yang kamu pahami hari ini?
</label>

<textarea id="r1"></textarea>

</div>


<div class="question">

<label>
2. Bagaimana informasi tersebut memengaruhi cara berpikirmu?
</label>

<textarea id="r2"></textarea>

</div>


<div class="question">

<label>
3. Apa satu tindakan kecil yang akan kamu lakukan?
</label>

<textarea id="r3"></textarea>

</div>


<button class="btn" onclick="saveReflection()">
Simpan Refleksi +10 XP
</button>

</div>

</section>

</main>

</div>


<div class="toast" id="toast"></div>


